{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@brian-agent/telemetry": ["./packages/telemetry/src/index.ts"],
			"@brian-agent/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@brian-agent/codemode": ["./packages/codemode/src/index.ts"],
			"@brian-agent/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@brian-agent/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@brian-agent/codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@brian-agent/codemode/source": ["./packages/codemode/src/source.ts"],
			"@brian-agent/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@brian-agent/mcp": ["./packages/mcp/src/index.ts"],
			"@brian-agent/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@brian-agent/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@brian-agent/ai": ["./packages/ai/src/index.ts"],
			"@brian-agent/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@brian-agent/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@brian-agent/ai/dist/*": ["./packages/ai/src/*"],
			"@brian-agent/agent": ["./packages/agent/src/index.ts"],
			"@brian-agent/a2a": ["./packages/a2a/src/index.ts"],
			"@brian-agent/a2a/*": ["./packages/a2a/src/*"],
			"@brian-agent/cli": ["./packages/coding-agent/src/index.ts"],
			"@brian-agent/cli/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@brian-agent/cli/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
